+Vec3 XtbCalculator::dipole_moment() const {
+  if (m_periodic || !m_calc) {
+    throw std::runtime_error("XtbCalculator::dipole_moment: molecular only");
+  }
+  const Vec &q = m_last_result.atomic_charges;
+  if (q.size() != num_atoms()) {
+    throw std::runtime_error(
+        "XtbCalculator::dipole_moment: call single_point_energy() first");
+  }
+  Vec3 mu = m_positions_bohr * q;
+  if (m_last_result.atomic_dipoles.cols() == num_atoms()) {
+    mu += m_last_result.atomic_dipoles.rowwise().sum();
+  }
+  return mu;
+}
+
+IVec XtbCalculator::ao_atoms() const {
+  if (!m_calc) throw std::runtime_error("XtbCalculator::ao_atoms: molecular only");
+  const auto &map = m_calc->bf_to_atom();
+  IVec out(map.size());
+  for (size_t i = 0; i < map.size(); ++i) out(i) = map[i];
+  return out;
+}
+
+IVec XtbCalculator::ao_angular_momenta() const {
+  if (!m_calc) throw std::runtime_error("XtbCalculator::ao_angular_momenta: molecular only");
+  const auto &basis = m_calc->basis();
+  IVec out(basis.nbf());
+  int bf = 0;
+  for (const auto &shell : basis.shells()) {
+    for (size_t k = 0; k < shell.size(); ++k) out(bf++) = shell.l;
+  }
+  return out;
+}
+
+Mat XtbCalculator::orbital_values(const Mat3N &points_bohr,
+                                  const Vec &coefficients) const {
+  if (!m_calc) throw std::runtime_error("XtbCalculator::orbital_values: molecular only");
+  const auto &basis = m_calc->basis();
+  if (coefficients.size() != static_cast<Eigen::Index>(basis.nbf())) {
+    throw std::runtime_error("XtbCalculator::orbital_values: coefficient count");
+  }
+  const Eigen::Index n = points_bohr.cols();
+  Mat out(4, n);
+  constexpr Eigen::Index block = 4096;
+  for (Eigen::Index start = 0; start < n; start += block) {
+    const Eigen::Index count = std::min(block, n - start);
+    const auto values =
+        occ::gto::evaluate_basis(basis, points_bohr.middleCols(start, count), 1);
+    out.block(0, start, 1, count) = (values.phi * coefficients).transpose();
+    out.block(1, start, 1, count) = (values.phi_x * coefficients).transpose();
+    out.block(2, start, 1, count) = (values.phi_y * coefficients).transpose();
+    out.block(3, start, 1, count) = (values.phi_z * coefficients).transpose();
+  }
+  return out;
+}
