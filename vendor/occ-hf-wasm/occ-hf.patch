+      // Valence: the exact potential of the wavefunction's charge
+      // distribution at points (bohr), in e/bohr -- each nucleus less any
+      // ECP core, plus the electrons.
+      .function("electricPotential",
+                optional_override([](const Wavefunction &wfn,
+                                     const occ::Mat3N &points) {
+                  return wfn.electric_potential(points);
+                }))
+      // Valence: the dipole of the density about the origin (e bohr). Each
+      // nucleus counts at Z less its ECP core electrons, which the density
+      // lacks; compute_multipoles<1> would count the full Z.
+      .function("dipoleMoment", optional_override([](const Wavefunction &wfn) {
+                  HartreeFock hf(wfn.basis);
+                  auto electrons = hf.compute_electronic_multipoles<1>(wfn.mo);
+                  Vec dipole(3);
+                  for (int c = 0; c < 3; c++)
+                    dipole(c) = electrons.components[1 + c];
+                  const auto &ecp = wfn.basis.ecp_electrons();
+                  for (size_t i = 0; i < wfn.atoms.size(); i++) {
+                    const auto &a = wfn.atoms[i];
+                    double z = a.atomic_number - ecp[i];
+                    dipole(0) += z * a.x;
+                    dipole(1) += z * a.y;
+                    dipole(2) += z * a.z;
+                  }
+                  return dipole;
+                }))
       .function("chelpgCharges", optional_override([](const Wavefunction &wfn) {
                   return chelpg_charges(wfn);
                 }))
